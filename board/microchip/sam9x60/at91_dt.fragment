# Extra kernel options for the SAM9X60 boards (at91_dt_defconfig + this file).
#
# This file used to be a saved "git diff": every line carried a '+' prefix, so
# kconfig parsed it as garbage and NONE of the options below were ever applied
# (the built kernel had "# CONFIG_OVERLAY_FS is not set" while this file asked
# for =y). Keep it a plain kconfig fragment - no '+'/'-' prefixes, no headers.
#
# Consumed by: sam9x60_medicam_defconfig, sam9x60_curiosity_{headless,graphics},
# sam9x60ek_{headless,graphics}.

# systemd needs a usable cgroup hierarchy; overlayfs is the basis for the
# read-only-rootfs work planned for stage 3.
CONFIG_POSIX_MQUEUE=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_RDMA=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y

# Filesystems: POSIX ACLs on ext4/tmpfs, overlayfs.
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_POSIX_ACL=y

# Networking: SYN cookies only. Netfilter is left to the at91_dt_defconfig on
# purpose (see plan F10: no conntrack in this kernel, so no stateful rules).
CONFIG_SYN_COOKIES=y

# Debugging: SysRq over the serial console. Without it systemd's
# /usr/lib/sysctl.d/50-default.conf fails at boot with
#   "Couldn't write '16' to 'kernel/sysrq', ignoring: No such file or directory"
# and a hung board cannot be inspected (useful for the stage 2 power-cut tests).
CONFIG_MAGIC_SYSRQ=y

# BPF + cgroup firewalling: systemd units declare IP firewall rules, and without
# it journald logs "unit configures an IP firewall, but the local system does
# not support BPF/cgroup firewalling" on every boot (and no firewall could ever
# work - plan F10).
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# USB gadget: ECM is available for a configfs-based network on the DEBUG port
# (plan F20, not used yet). The webcam gadget is not needed - the camera path is
# ISI + OV2640.
CONFIG_USB_CONFIGFS_ECM=y
