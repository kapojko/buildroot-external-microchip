#
# Line endings and exec bits must survive a Windows checkout.
#
# The Windows checkout uses core.autocrlf=true and only reaches the WSL build
# host; a CRLF *.fragment or *_defconfig is silently mis-parsed by kconfig and a
# CRLF *.sh fails with "bad interpreter". Pin the text formats, and mark the
# scripts Buildroot executes directly as executable so no "remember to chmod +x"
# step is needed.

# Scripts invoked by Buildroot through BR2_ROOTFS_POST_*_SCRIPT.
*.sh                                 text eol=lf executable
board/**/post_build.sh               text eol=lf executable
board/**/post-image-pre.sh           text eol=lf executable
board/**/post-image.sh               text eol=lf executable
board/**/fs-overlay/usr/bin/*.sh     text eol=lf executable
board/**/fs-overlay/usr/sbin/*.sh    text eol=lf executable
board/**/fs-overlay/usr/local/bin/*.sh  text eol=lf executable
board/**/fs-overlay/usr/local/sbin/*.sh text eol=lf executable
board/**/fs-overlay/etc/init.d/S*    text eol=lf executable
configs/post-image*.sh               text eol=lf executable
configs/post-build*.sh               text eol=lf executable

# NOTE: the "executable" attribute above is informative only - git does not turn
# it into mode 100755 on add (Windows has core.fileMode=false). New scripts must
# be added with: git update-index --chmod=+x <path>

# PowerShell flashing helper (executed via "powershell -File").
*.ps1                                text eol=crlf

# Kernel/bootloader sources and kconfig fragments: kconfig and dtc want LF.
*.dts                                text eol=lf
*.dtsi                               text eol=lf
*.fragment                           text eol=lf
*.config                             text eol=lf
*_defconfig                          text eol=lf

# Board data files parsed line by line (U-Boot env, genimage, systemd units).
*.txt                                text eol=lf
*.cfg                                text eol=lf
*.service                            text eol=lf
*.mount                              text eol=lf
*.preset                             text eol=lf
*.conf                               text eol=lf
*.md                                 text eol=lf

# Rootfs overlay files that have no conventional extension but land on the target
# as text (a CRLF sshd_config breaks sshd, a CRLF motd prints ^M).
motd                                 text eol=lf
sshd_config                          text eol=lf

*.py                                 text eol=lf
